{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fnvcoop/snapshot.schema.json",
  "title": "fnv-coop canonical world-state snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "shared": {
      "$ref": "#/definitions/shared"
    },
    "perPlayer": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/player"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "formRef": {
      "type": "string",
      "pattern": "^([^:/\\s]+\\.(esm|esp|esl):[0-9A-F]{6}|dyn:[0-9A-F]{8})$"
    },
    "meta": {
      "type": "object",
      "required": [
        "gameVersion",
        "counts"
      ],
      "properties": {
        "gameVersion": {
          "type": "string"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pluginsHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "timestamp": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "required": [
            "quests",
            "globals"
          ],
          "properties": {
            "quests": {
              "type": "integer",
              "minimum": 0
            },
            "globals": {
              "type": "integer",
              "minimum": 0
            },
            "reputations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "skippedObjectiveTargets": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "shared": {
      "type": "object",
      "required": [
        "quests",
        "globals",
        "reputations",
        "karma",
        "factionRanks",
        "refs"
      ],
      "properties": {
        "quests": {
          "type": "object",
          "patternProperties": {
            "^": {
              "$ref": "#/definitions/quest"
            }
          },
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "globals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/global"
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "reputations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "fame",
              "infamy"
            ],
            "properties": {
              "edid": {
                "type": "string"
              },
              "fame": {
                "type": "number"
              },
              "infamy": {
                "type": "number"
              }
            }
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "karma": {
          "type": "number"
        },
        "factionRanks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "rank"
            ],
            "properties": {
              "edid": {
                "type": "string"
              },
              "rank": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "exists"
            ],
            "properties": {
              "exists": {
                "type": "boolean"
              },
              "edid": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "alive": {
                "type": "boolean"
              },
              "cell": {
                "type": "string"
              },
              "vars": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        }
      },
      "additionalProperties": false
    },
    "quest": {
      "type": "object",
      "required": [
        "edid",
        "rawFlags",
        "running",
        "completed",
        "failed",
        "currentStage",
        "completedStages",
        "objectives",
        "vars"
      ],
      "properties": {
        "edid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rawFlags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "running": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "failed": {
          "type": "boolean"
        },
        "currentStage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "completedStages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "objectives": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "displayed",
              "completed"
            ],
            "properties": {
              "displayed": {
                "type": "boolean"
              },
              "completed": {
                "type": "boolean"
              }
            }
          }
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "edid": {
          "type": "string"
        },
        "type": {
          "enum": [
            "s",
            "l",
            "f"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "actorValues",
        "inventory",
        "caps",
        "perks",
        "position"
      ],
      "properties": {
        "actorValues": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "base",
              "current"
            ],
            "properties": {
              "base": {
                "type": "number"
              },
              "current": {
                "type": "number"
              }
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "count"
            ],
            "properties": {
              "edid": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "caps": {
          "type": "integer",
          "minimum": 0
        },
        "perks": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "propertyNames": {
            "$ref": "#/definitions/formRef"
          }
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "cell"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "rotZ": {
              "type": "number"
            },
            "cell": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
