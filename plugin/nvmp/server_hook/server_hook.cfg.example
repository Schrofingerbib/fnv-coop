# server_hook.cfg: optional, read once when the server starts. Place next to nvmp_storyserver.exe.
# hostowned.txt (FormIDs, one per line, hex, '#' comments) lives in the same folder and is hot-reloaded.

enabled = 1                 # master switch (0 = load but install nothing)
block_handover = 1          # keep host-owned refs on the host while the host is connected (hot-swap reselect)
drop_actors = 1             # filter encounter type 0 (actors)
drop_references = 1         # filter types 1/2/3 (references, doors, containers)

# How the host is identified:
#   auto      loopback peer (the host joins via localhost); fallback to the first connected character
#             only while no loopback peer is known
#   loopback  loopback peer / host_address only; unknown sender => allowed (fail open)
#   first     the first connected character
host_mode = auto

# Extra peer addresses to treat as the host (e.g. the host joins through the LAN/public IP). Repeatable.
# host_address = 192.168.1.20

poll_ms = 1000              # hostowned.txt change-poll interval
log_all = 0                 # 1 = also log decisions for unflagged forms (very chatty)
