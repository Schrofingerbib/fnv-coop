; Add to Data\NVSE\Plugins\nvcoop.ini. All keys optional. Applies NV:MP 9.4 client.dll patches from inside nvcoop.dll.
[nvmp]
enabled=1            ; 0 = never touch NV:MP
quested=1            ; client.quested_not_localized (the recommended first patch; default on)
questedRef=0         ; client.quested_ref_not_localized (quest items / containers)
questedRefScan=0     ; client.quested_ref_scan_include
scriptedRef=0        ; client.scripted_ref_not_localized (runtime-created refs; risky)
ghostDamage=0        ; client.ghost_damage_locality_byte + client.ghost_damage_flag31
patches=             ; explicit comma list (full or short names) replacing the flags above; "none" = nothing
autoApply=1          ; 0 = only the "nvmp.patches" RPC applies patches
pollFrames=60        ; fallback poll period while client.dll is not loaded yet
; env NVCOOP_NVMP_PATCHES=quested,questedRef overrides patches=
; ldrNotify=0        ; 1 = also wake on LdrRegisterDllNotification (off by default: the callback runs under the loader lock)
