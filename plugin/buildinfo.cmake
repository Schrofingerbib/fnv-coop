# Generates ${OUT} (build_info.h) with the git commit + dirty flag; rewritten only when content changes.
execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE HASH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE DIRTY OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT HASH)
  set(HASH "unknown")
endif()
if(DIRTY)
  set(DIRTYFLAG 1)
else()
  set(DIRTYFLAG 0)
endif()
set(CONTENT "#pragma once\n#define NVCOOP_GIT_HASH \"${HASH}\"\n#define NVCOOP_GIT_DIRTY ${DIRTYFLAG}\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
else()
  set(OLD "")
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUT}" "${CONTENT}")
endif()
