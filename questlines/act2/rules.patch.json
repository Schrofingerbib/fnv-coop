  {
   "kind": "PartyWarp",
   "param": "absent",
   "proposed_value": "skip",
   "why": "elevators and doors are free-roam transfers: a player who is not in the car must neither hold the others (absent=hold) nor be dragged along (absent=warp). Needs a third value: only players within `radius` of the trigger are moved.",
   "extra_param": {
    "radius": 512
   },
   "quests": [
    "VDialogueLucky38Entrance",
    "VMQ02"
   ]
  },
  {
   "kind": "ShareKarmaRep",
   "param": "faction_relations",
   "proposed_value": true,
   "why": "SetPCEnemyOfFaction / SetEnemy PlayerFaction / ClearFactionPlayerEnemyFlag change the player's faction standing, which the owner decision shares (party = one Courier); no existing kind carries faction relations.",
