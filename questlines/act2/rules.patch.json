 "new_kinds": [
  {
   "kind": "GuestEventRelay",
   "summary": "A player-triggered script event (OnAdd/OnDrop player, OnTriggerEnter player, OnActivate by a player) that occurs on a guest is relayed to the host, which runs the script block once with the originating player as `player`/IsActionRef and captures its effects as usual.",
   "params": {
    "events": [
     "OnAdd",
     "OnDrop",
     "OnTriggerEnter",
     "OnActivate",
     "OnHit",
     "OnDeath"
    ],
    "scripts": "[script EDIDs]",
    "actor": "originator",
    "dedupe": "per event id"
   },
   "why_not_existing": "None of the 16 kinds routes a world event from a guest to the host. PartyAwareCond only reduces conditions the host already evaluates; InitiatorDialogue covers INFOs only; QuestItemDup covers script AddItem, not loot.",
   "quests": [
    "VMQTops",
    "VMQ02",
    "VMS40"
   ]
  },
  {
   "kind": "ModalChoice",
   "summary": "A scripted modal ShowMessage with buttons (GetButtonPressed) is shown to the initiating player, answered by that player, and the answer is returned to the host script; point-of-no-return prompts (VEndGameWarningMsg*) additionally require party consent.",
   "params": {
    "decider": "initiator",
    "consent": "party|none",
    "timeout_s": 120
   },
   "why_not_existing": "InitiatorDialogue only covers INFO topics. Elevator floor menus and the endgame warning are ShowMessage buttons in object scripts.",
   "quests": [
    "VMQ02",
    "VMQ03a",
    "VMQ03b",
    "VMQ04",
    "VMQCaesarFail",
    "VMQNCRFail",
    "VMQTops",
    "VDialogueLucky38Entrance"
   ]
  }
 ],
