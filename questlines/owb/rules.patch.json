  "NVDLC03MQ05": {
   "op": "replace",
   "why": "Existing curated entry has empty markers/cells/masks and models the Teleporter as a plain party-warp. The finale is (1) a hostile/peace branch with a shared faction relation, (2) a Think Tank door that starts the ending slideshow (IsActionRef Player), (3) a per-player brain/heart/spine restoration and (4) a Teleporter that every player receives but that moves only its user and the party members within range.",
   "rules": [
    {
     "kind": "PartyTether",
     "params": {
      "cells": [
       "NVDLC03ThinkTank"
      ],
      "gather": "wait",
      "gate": "ThinkTankDoor ending: refused until every slot is inside NVDLC03ThinkTank (message instead of Activate)"
     },
     "origin": "curated"
    },
    {
     "kind": "Barrier",
     "params": {
      "step": "all-players-pass",
      "refs": [
       "NVDLC03ThinkTankToBigEmptyDoorREF"
      ],
      "note": "exit door of the Think Tank starts the ending only after the whole party is inside"
     },
     "origin": "curated"
    },
    {
     "kind": "PartyWarp",
     "params": {
      "markers": [
       "NVDLC03SlideShowMarkerREF",
       "NVDLC03EndMarker"
      ],
      "mode": "slot-offset",
      "absent": "hold",
      "note": "Ending and TransitionToTheSink both MoveTo; Teleporter use is a separate range-limited warp (WeapTeleporter)"
     },
     "origin": "curated"
    },
    {
     "kind": "SetPlayerControls",
     "params": {
      "scope": "all",
      "release": "host-effect",
      "timeout_s": 900,
      "masks": [
       "1 1 1 1 1 1 1"
      ]
     },
     "origin": "curated"
    },
    {
     "kind": "SlideshowEnd",
     "params": {
      "run": "host-once",
      "lock": "all",
      "release": "together"
     },
     "origin": "curated"
    },
    {
     "kind": "SaveSuppress",
     "params": {},
     "origin": "curated"
    },
    {
     "kind": "PerPlayerScene",
     "params": {
      "scene": "AutoDoc body-part restoration (NVDLC03SinkAutoDoc menu)",
      "per_player": [
       "bRestoreBodyParts",
       "bImplants",
       "nButton",
       "*SwapMsg",
       "perks:Brainless/Spineless/Heartless <-> BigBrained/CardiacArrest/ReinforcedSpine",
       "caps cost"
      ],
      "shared": [
       "bRestoredBrain",
       "bRestoredHeart",
       "bRestoredSpine -> become \"any player restored\" flags"
      ],
      "note": "bRestored* are single quest vars read by the menu; per-player state must come from HasPerk, not from them"
     },
     "origin": "curated"
    },
    {
     "kind": "QuestItemDup",
     "params": {
      "recipient": "all",
      "items": [
       "NVDLC03PlayerBrain"
      ],
      "note": "each player carries their own brain; stage 100 swap runs for every holder"
     },
     "origin": "curated"
    },
    {
     "kind": "RewardAll",
     "params": {
      "include": [
       "AddItem",
       "EquipItem",
       "AddPerk",
       "RemovePerk"
      ],
      "items": [
       "NVDLC03WeapTeleporter"
      ],
      "perks": [
       "NVDLC03BigBrainedPerk",
       "NVDLC03CardiacArrestPerk"
      ]
     },
     "origin": "curated"
    },
    {
     "kind": "ShareKarmaRep",
     "params": {
      "note": "ending slides branch on Karma (<= -250 bad); shared Courier karma"
     },
     "origin": "curated"
    },
    {
     "kind": "PartyAwareCond",
     "params": {
      "funcs": {
       "IsActionRef": "initiator",
       "GetDistance": "min-over-party",
       "GetItemCount": "initiator",
       "HasPerk": "initiator",
       "IsInCombat": "any-party-member",
       "OnTrigger": "any-party-member (block header filters on the Player ref; a guest ghost never matches it)"
      }
     },
     "origin": "curated"
    },
    {
     "kind": "InitiatorDialogue",
     "params": {},
     "origin": "curated"
    }
   ]
  },
