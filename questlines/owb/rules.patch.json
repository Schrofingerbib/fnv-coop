      "funcs": {
       "IsActionRef": "initiator",
       "OnTrigger": "any-party-member (block header filters on the Player ref; a guest ghost never matches it)",
       "GetQuestCompleted": "shared"
      }
     },
     "origin": "curated"
    },
    {
     "kind": "RewardAll",
     "params": {},
     "origin": "curated"
    },
    {
     "kind": "InitiatorDialogue",
     "params": {},
     "origin": "curated"
    }
   ]
  },
