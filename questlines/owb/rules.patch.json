{
 "schema": 1,
 "target": "docs/quest-policies/rules.json",
 "slug": "owb",
 "note": "Proposal only (rules.json is owned by L9). op=replace: quest already has an entry; op=add: it has none.",
 "base_kinds": [
  "PartyTether",
  "PartyWarp",
  "SetPlayerControls",
  "Barrier",
  "PerPlayerScene",
  "SlideshowEnd",
  "CompanionOwner",
  "SaveSuppress",
  "FastTravelLock",
  "PartyAwareCond",
  "QuestItemDup",
  "RewardAll",
  "RemoveItemPerOwner",
  "ShareKarmaRep",
  "InitiatorDialogue",
  "ExcludeFromGate"
 ],
 "edid_param_keys": [
  "cells",
  "markers",
  "anchor",
  "refs",
  "perks",
  "items",
  "scripts",
  "quests"
 ],
 "quests": {
  "NVDLC03MQ00": {
   "op": "replace",
   "why": "Derived entry put a PartyTether on GSDocMitchellHouse: the script reads Player.GetInCell GSDocMitchellHouse == 0 as \"chargen finished, start the DLC\", i.e. an EXIT gate; tethering the party into the house is the opposite of what is needed. Entry is a one-way trip (no return until the Teleporter at MQ05 stage 100) so the whole party must gather at the crashed satellite first.",
   "rules": [
    {
     "kind": "PartyTether",
     "params": {
      "cells": [],
      "anchor": "NVDLC03CrashedSatelliteREF",
      "radius": 1500,
      "gather": "auto-warp",
      "gate": "MQ00 stage 100 is set by the satellite MenuMode button; refuse until every slot is inside the radius"
     },
     "origin": "curated"
    },
    {
     "kind": "SetPlayerControls",
     "params": {
      "scope": "all",
      "release": "host-effect",
      "timeout_s": 120,
      "masks": [
       "1 1 1 1 0 1 1"
      ]
     },
     "origin": "curated"
    },
    {
     "kind": "PartyWarp",
     "params": {
      "markers": [
       "NVDLC03SlideShowMarkerREF"
      ],
      "mode": "slot-offset",
      "absent": "hold"
     },
     "origin": "curated"
    },
    {
     "kind": "SaveSuppress",
     "params": {},
     "origin": "curated"
    },
    {
     "kind": "CompanionOwner",
     "params": {
      "owner": "recruiter",
      "action": "dismiss-all-on-entry",
      "note": "TeleportEffectTimer fires every follower; each recruiter keeps their own companion state"
     },
     "origin": "curated"
    },
    {
     "kind": "PartyAwareCond",
     "params": {
      "funcs": {
       "GetInCell": "exit:any-in (nEnableDLC==0 gate: start only when nobody is inside GSDocMitchellHouse)",
       "IsActionRef": "initiator",
       "IsPlayerActionActive": "initiator",
       "IsSneaking": "initiator",
       "IsInCombat": "any-party-member",
       "OnTrigger": "any-party-member (block header filters on the Player ref; a guest ghost never matches it)"
      }
     },
     "origin": "curated"
    },
    {
     "kind": "RewardAll",
     "params": {},
     "origin": "curated"
    },
    {
     "kind": "ShareKarmaRep",
     "params": {
      "note": "Player.AddToFaction NVDLC03PlayerFaction: faction membership is shared (coordinator decision)"
     },
     "origin": "curated"
    },
    {
     "kind": "QuestItemDup",
     "params": {
      "recipient": "all"
     },
     "origin": "curated"
    },
    {
     "kind": "InitiatorDialogue",
     "params": {},
     "origin": "curated"
    }
   ]
  },
  "NVDLC03MQ01": {
   "op": "replace",
   "why": "Stage 10 removes brain, spine and heart from THE PLAYER: every party member must lose them. AddPerk is BLOCK_CMD only (never captured), so RewardAll{include AddPerk} needs a SetPerk capture hook. Stage 10 also rewrites GameMonth/GameDay (shared globals, host once). The derived QuestItemDup is dropped: the only inventory change is the gown, routed by RewardAll.include.",
   "rules": [
    {
     "kind": "RewardAll",
     "params": {
      "include": [
       "AddPerk",
       "AddItem",
       "EquipItem"
      ],
      "perks": [
       "NVDLC03BrainlessPerk",
       "NVDLC03SpinelessPerk",
       "NVDLC03HeartlessPerk"
      ],
      "items": [
       "NVDLC03PatientGown"
      ],
      "note": "every player gets the three body-part perks and the patient gown"
     },
     "origin": "curated"
    },
    {
     "kind": "SaveSuppress",
     "params": {
      "release": "PlayerStartTrigger (Player.RemoveScriptPackage)"
     },
     "origin": "curated"
    },
    {
     "kind": "SetPlayerControls",
     "params": {
      "scope": "all",
      "release": "host-effect",
      "timeout_s": 300,
      "masks": [
       "1 1 1 1 0 1 1"
      ]
     },
     "origin": "curated"
    },
    {
     "kind": "PartyAwareCond",
     "params": {
      "funcs": {
       "GetLevel": "initiator: XP tier computed once on the host from ITS level (NVDLC03Act1XP..Act3XP are shared globals)",
       "OnTrigger": "any-party-member (block header filters on the Player ref; a guest ghost never matches it)",
       "IsActionRef": "initiator"
      }
     },
     "origin": "curated"
    },
    {
     "kind": "InitiatorDialogue",
     "params": {},
     "origin": "curated"
    }
   ]
  },
