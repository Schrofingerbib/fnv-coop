 "proposals": {
  "kinds": [
   {
    "kind": "PerPlayerVars",
    "params": {
     "quest": "EDID of a quest",
     "vars": [
      "quest-script variable names that hold per-player state"
     ]
    },
    "justification": "Casino state is stored in SHARED quest variables: bans and winnings tiers (vCasinoComps*.Banned/SmallFry/BigWinner/Whale), frisk/weapon-confiscation state (vDialogueGomorrah.iInGomorrah/bGunsAllowed/iWeaponAlert, VDialogueTops.PlayerFrisked), room rental (VFreeformTheStreet01.RoomRented). SetScriptVar is last-writer-wins and shared, so one player winning big would ban or comp the whole party, and one player being frisked would mark everybody frisked. PerPlayerScene cannot express persistent per-slot variables and no existing kind keys state by player.",
    "semantics": "Listed vars replicate as (slot, value); a read inside a script that runs for slot S sees S value; the host applies SetScriptVar writes to the originating slot only. Bans/frisk then stay per player, shared quest state stays shared.",
    "interim": "none: until implemented casino bans/frisks follow the host player only"
   }
  ],
  "kind_uses": {
   "vCasinoCompsAtomicWrangler": [
    "SmallFry",
    "BigWinner",
    "Whale",
    "Banned",
    "doonce"
   ],
   "vCasinoCompsVikkiAndVance": [
    "bFloorManagerIncoming",
    "SmallFry",
    "BigWinner",
    "Whale",
    "Banned"
   ],
   "vCasinoCompsGomorrah": [
    "bFloorManagerIncoming",
    "SmallFry",
    "BigWinner",
    "Whale",
    "Banned"
   ],
   "VCasinoCompsUltraLuxe": [
    "bFloorManagerIncoming",
    "SmallFry",
    "BigWinner",
    "Whale",
    "Banned"
   ],
   "vCasinoCompsTheTops": [
    "bFloorManagerIncoming",
    "SmallFry",
    "BigWinner",
    "Whale",
    "Banned"
   ],
   "vDialogueGomorrah": [
    "iInGomorrah",
    "bGunsAllowed",
    "iWeaponAlert",
    "iPlayerRemFaction",
    "iTrespassAlert",
    "bRecptIntimidate"
   ],
   "VDialogueTops": [
    "PlayerFrisked",
    "Unarmed",
    "Holdout"
   ]
  },
  "engine_changes": [
   {
    "id": "E1",
    "what": "PerPlayerScene must have semantics: Default recipients of AddItem/RemoveItem/ModActorValue/SetPerk/SetPlayerControls in txns whose cause quest has the rule resolve to Origin (today the kind is loaded and counted only: rules.cpp handled-set, no code path).",
    "owner": "L4"
   },
   {
    "id": "E2",
    "what": "RemoveItemPerOwner must be purchase-atomic: when a txn contains a RemoveItem rewritten to Origin, AddItem/SetPerk/ModActorValue on the player in the same txn with Default recipient must also go to Origin (today a DialogueResult cause resolves them to All via policy.cpp isQuestRewardCause, so a purchase serves everybody).",
    "owner": "L4"
   },
   {
    "id": "E3",
    "what": "Follow-up script runs after a dialogue (Julie/Alex/Markland GameMode treatment blocks, Variable01 handshake) must inherit the dialogue initiator as txn origin; today they run on the host with origin=host, so the patient is never the origin when a guest is treated.",
    "owner": "L4+L8"
   },
   {
    "id": "E4",
    "what": "Finish protocol section 12 for the activation scripts listed in policy_review F2: acting-player resolution (L5 choke point) and ghost refID (L6), pickups and TriggerEnter forwarding. v1 runs the interaction as the host player, so `player.MoveTo/RemoveItem/RemoveAllTypedItems` inside forwarded OnActivate scripts (elevators, AutoDoc, frisk) still act on the host.",
    "owner": "L5+L6+L10"
   },
   {
    "id": "E5",
    "what": "GetButtonPressed message boxes must be shown to the activating player and the button routed to the host; with forwarded activation the box opens on the host screen and only the host can answer it (the section 12 decision covers Fort -> Dam only).",
    "owner": "L5+L8"
   },
   {
    "id": "E6",
    "what": "Capture/apply still missing for commands used here (cmdtable.py, re-checked against engine_hooks.cpp / apply_remote.cpp by run_tests.py): SetPlayerTeammate (CompanionOwner), Say/SayTo/StartConversation (ForcedDialogue), RestoreAV/ResetHealth, EnableFastTravel, RemoveAllTypedItems and the transfer half of RemoveAllItems, RemoveFromAllFactions, SetPCEnemyOfFaction/ClearFactionPlayerEnemyFlag/SendAssaultAlarm, ShowMap, MarkForDelete, SwapTexture, NPC-subject AddPerk, ref-script variables (RefScriptVar). Apply side: SpawnRef and RequestSave have no RemoteApplier path.",
    "owner": "L5"
   },
   {
    "id": "E9",
    "what": "Casino frisk lockers are single shared containers (TopsWeaponLockerREF, TopsCompanionLocker1/2REF, vGOMPlayerEquipmentContainer, vGOMCompanion1/2EquipmentContainer): two frisked players would mix their weapons. Extend the coordinator decision on per-slot player storage (protocol section 12) to these lockers.",
    "owner": "L10+L4"
   },
   {
    "id": "E8",
    "what": "Player-filtered event blocks (`Begin OnHit player`, `OnDeath player`, `OnStartCombat player`) fire only for the host player actor. A guest ghost's hit or kill must dispatch them too (any party member counts as \"player\"), otherwise kill attribution, Kings-hate-player, theft/assault reactions and fail-on-kill quests only ever see the host.",
    "owner": "L5+L6"
   },
   {
    "id": "E7",
    "what": "forms.json.gz lacks the marker/cell EditorIDs rules.json already names (11 PartyWarp params unresolved) and the cells scripts reference via GetInCell (FreesideAtomicWrangler, ULMembersOnly, OVWestSewers03, ...): extend the forms table so the rules resolver can map them.",
    "owner": "L3"
   }
  ]
 },
