{
  "schema": 1,
  "name": "goodsprings_fight",
  "title": "Goodsprings fight: 2 players, 3 raiders",
  "description": "Both players stand at the Powder Gang position and three gang members are alive. The host kills the first, the guest kills the second, the host the third. After each kill every machine must agree who is dead and who is not.",
  "players": 2,
  "tags": [
    "combat",
    "goodsprings",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "gang1": {
      "ref": "FalloutNV.esm:104C70",
      "edid": "GSPG01Ref",
      "sig": "ACHR"
    },
    "gang2": {
      "ref": "FalloutNV.esm:104C77",
      "edid": "GSPG02Ref",
      "sig": "ACHR"
    },
    "gang3": {
      "ref": "FalloutNV.esm:104C75",
      "edid": "GSPG03Ref",
      "sig": "ACHR"
    },
    "gangMarker": {
      "ref": "FalloutNV.esm:105D4C",
      "edid": "GoodspringsPowderGangMarker",
      "sig": "REFR"
    }
  },
  "setup": [
    {
      "id": "enable_gang1",
      "op": "enable",
      "ref": "$gang1"
    },
    {
      "id": "enable_gang2",
      "op": "enable",
      "ref": "$gang2"
    },
    {
      "id": "enable_gang3",
      "op": "enable",
      "ref": "$gang3"
    },
    {
      "id": "players_to_gang",
      "op": "moveto",
      "who": "player",
      "to": "$gang1",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "all_alive_1",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "value": 0
    },
    {
      "id": "all_alive_2",
      "op": "check",
      "kind": "dead",
      "ref": "$gang2",
      "value": 0
    },
    {
      "id": "all_alive_3",
      "op": "check",
      "kind": "dead",
      "ref": "$gang3",
      "value": 0
    },
    {
      "id": "host_kills_1",
      "op": "kill",
      "ref": "$gang1",
      "on": "host"
    },
    {
      "id": "g1_dead_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "g2_still_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gang2",
      "value": 0
    },
    {
      "id": "guest_kills_2",
      "op": "kill",
      "ref": "$gang2",
      "on": "guest"
    },
    {
      "id": "g2_dead_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$gang2",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "g3_still_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gang3",
      "value": 0
    },
    {
      "id": "host_kills_3",
      "op": "kill",
      "ref": "$gang3",
      "on": "host"
    },
    {
      "id": "g3_dead_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$gang3",
      "value": 1,
      "timeout": 8
    }
  ]
}
