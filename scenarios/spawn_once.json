{
  "schema": 1,
  "name": "spawn_once",
  "title": "Spawn test: an encounter appears once",
  "description": "The host spawns one Powder Ganger at the gang marker. Every machine must see exactly one of that kind at that marker, and the count must stay at one after a settle period (no double spawn from the guest). The count uses the dev bridge method dev.countRefs (T6a, needs [dev] bots=1) on the base form, over the whole loaded world, so other Powder Gangers of the same base in loaded cells would be counted too: the scenario assumes a clean Goodsprings.",
  "players": 2,
  "tags": [
    "spawn",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "gangMarker": {
      "ref": "FalloutNV.esm:105D4C",
      "edid": "GoodspringsPowderGangMarker",
      "sig": "REFR"
    },
    "gangBase": {
      "ref": "FalloutNV.esm:104DF1",
      "edid": "GSPGHM2",
      "sig": "NPC_"
    },
    "gangRef": {
      "ref": "FalloutNV.esm:104DF2",
      "edid": "GSPG04Ref",
      "sig": "ACHR"
    }
  },
  "setup": [
    {
      "id": "players_to_marker",
      "op": "moveto",
      "who": "player",
      "to": "$gangMarker",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 2
    }
  ],
  "steps": [
    {
      "id": "none_before",
      "op": "check",
      "kind": "spawn_count",
      "ref": "$gangMarker",
      "base": "$gangBase",
      "value": 0,
      "note": "count of this base near the marker before the spawn"
    },
    {
      "id": "host_spawns",
      "op": "spawn",
      "base": "$gangBase",
      "at": "$gangMarker",
      "count": 1,
      "on": "host"
    },
    {
      "id": "one_everywhere",
      "op": "check",
      "kind": "spawn_count",
      "ref": "$gangMarker",
      "base": "$gangBase",
      "value": 1,
      "timeout": 10
    },
    {
      "id": "wait_for_duplicates",
      "op": "wait",
      "seconds": 5
    },
    {
      "id": "still_one",
      "op": "check",
      "kind": "spawn_count",
      "ref": "$gangMarker",
      "base": "$gangBase",
      "value": 1
    },
    {
      "id": "machines_agree",
      "op": "check",
      "kind": "spawn_count",
      "ref": "$gangMarker",
      "base": "$gangBase",
      "cmp": "same"
    }
  ]
}
