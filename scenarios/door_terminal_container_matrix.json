{
  "schema": 1,
  "name": "door_terminal_container_matrix",
  "title": "Door / terminal / container matrix",
  "description": "One pass over the object types that carry state: a door, a gate, a container and a terminal. Each is changed by one player (lock, unlock, add item, remove item) and the other player must see the same result.",
  "players": 2,
  "tags": [
    "objects",
    "doors",
    "containers",
    "terminals",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "docDoor": {
      "ref": "FalloutNV.esm:103E61",
      "edid": "GSDocMitchellHouseIntDoorREF",
      "sig": "REFR"
    },
    "gate": {
      "ref": "FalloutNV.esm:15EFB7",
      "edid": "GSBighornerGateRef",
      "sig": "REFR"
    },
    "dresser": {
      "ref": "FalloutNV.esm:103E37",
      "edid": "DocMitchellDresserRef",
      "sig": "REFR"
    },
    "terminal": {
      "ref": "FalloutNV.esm:10776C",
      "edid": "ScoreTerminalREF",
      "sig": "REFR"
    },
    "stimpak": {
      "ref": "FalloutNV.esm:015169",
      "edid": "Stimpak",
      "sig": "ALCH"
    }
  },
  "setup": [
    {
      "id": "players_to_door",
      "op": "moveto",
      "who": "player",
      "to": "$docDoor",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "host_locks_door",
      "op": "lock",
      "ref": "$docDoor",
      "level": 50,
      "on": "host"
    },
    {
      "id": "door_locked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$docDoor",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "guest_unlocks_door",
      "op": "unlock",
      "ref": "$docDoor",
      "on": "guest"
    },
    {
      "id": "door_unlocked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$docDoor",
      "value": 0,
      "timeout": 8
    },
    {
      "id": "host_locks_gate",
      "op": "lock",
      "ref": "$gate",
      "level": 75,
      "on": "host"
    },
    {
      "id": "gate_locked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$gate",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "guest_unlocks_gate",
      "op": "unlock",
      "ref": "$gate",
      "on": "guest"
    },
    {
      "id": "gate_unlocked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$gate",
      "value": 0,
      "timeout": 8
    },
    {
      "id": "host_fills_dresser",
      "op": "additem",
      "who": "$dresser",
      "item": "$stimpak",
      "count": 3,
      "on": "host"
    },
    {
      "id": "dresser_has_3",
      "op": "check",
      "kind": "item_count",
      "who": "$dresser",
      "item": "$stimpak",
      "value": 3,
      "timeout": 8
    },
    {
      "id": "guest_takes_2",
      "op": "removeitem",
      "who": "$dresser",
      "item": "$stimpak",
      "count": 2,
      "on": "guest"
    },
    {
      "id": "dresser_has_1",
      "op": "check",
      "kind": "item_count",
      "who": "$dresser",
      "item": "$stimpak",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "host_locks_terminal",
      "op": "lock",
      "ref": "$terminal",
      "level": 50,
      "on": "host"
    },
    {
      "id": "terminal_locked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$terminal",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "guest_unlocks_terminal",
      "op": "unlock",
      "ref": "$terminal",
      "on": "guest"
    },
    {
      "id": "terminal_unlocked_everywhere",
      "op": "check",
      "kind": "locked",
      "ref": "$terminal",
      "value": 0,
      "timeout": 8
    }
  ]
}
