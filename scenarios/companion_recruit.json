{
  "schema": 1,
  "name": "companion_recruit",
  "title": "Companion recruit (Boone)",
  "description": "The host recruits Craig Boone: he is enabled, brought to the host and made a teammate. Both machines must show him as a teammate and alive, and he must stay next to the host.",
  "players": 2,
  "tags": [
    "companion",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "boone": {
      "ref": "FalloutNV.esm:096BCE",
      "edid": "CraigBooneREF",
      "sig": "ACHR"
    }
  },
  "setup": [
    {
      "id": "settle",
      "op": "wait",
      "seconds": 1
    }
  ],
  "steps": [
    {
      "id": "host_recruits",
      "op": "recruit",
      "ref": "$boone",
      "on": "host"
    },
    {
      "id": "is_teammate_everywhere",
      "op": "check",
      "kind": "teammate",
      "ref": "$boone",
      "value": 1,
      "timeout": 10
    },
    {
      "id": "alive_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$boone",
      "value": 0
    },
    {
      "id": "near_the_host",
      "op": "check",
      "kind": "distance",
      "a": "$boone",
      "b": "player",
      "cmp": "<=",
      "value": 600,
      "on": "host",
      "timeout": 10
    }
  ]
}
