{
  "schema": 1,
  "name": "fast_travel_tether",
  "title": "Fast-travel tether",
  "description": "The host fast travels from Goodsprings to Novac while the guest stays behind. With party consent the guest must be pulled to the same place; out of combat only. The fast travel step needs the proposed bridge method test.fasttravel and is blocked until it exists. How consent is given in the test is unknown and not modeled here.",
  "players": 2,
  "tags": [
    "travel",
    "tether",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "novac": {
      "ref": "FalloutNV.esm:09289B",
      "edid": "NovacMapMarker",
      "sig": "REFR"
    },
    "gangMarker": {
      "ref": "FalloutNV.esm:105D4C",
      "edid": "GoodspringsPowderGangMarker",
      "sig": "REFR"
    }
  },
  "setup": [
    {
      "id": "players_to_start",
      "op": "moveto",
      "who": "player",
      "to": "$gangMarker",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "both_start_in_goodsprings",
      "op": "check",
      "kind": "distance",
      "a": "player",
      "b": "$gangMarker",
      "cmp": "<=",
      "value": 3000
    },
    {
      "id": "host_fast_travels",
      "op": "fast_travel",
      "marker": "$novac",
      "on": "host"
    },
    {
      "id": "travel_window",
      "op": "wait",
      "seconds": 10
    },
    {
      "id": "host_at_novac",
      "op": "check",
      "kind": "distance",
      "a": "player",
      "b": "$novac",
      "cmp": "<=",
      "value": 3000,
      "on": "host",
      "timeout": 30
    },
    {
      "id": "guest_tethered_to_novac",
      "op": "check",
      "kind": "distance",
      "a": "player",
      "b": "$novac",
      "cmp": "<=",
      "value": 3000,
      "on": "guest",
      "timeout": 30
    }
  ]
}
