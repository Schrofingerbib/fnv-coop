{
  "schema": 1,
  "name": "dialogue_spectator",
  "title": "Dialogue: the guest talks to Sunny, the host watches",
  "description": "Sunny Smiles' opening conversation (VCG02 'Back in the Saddle', objective 10 done): the guest answers 'Okay, I'm in.' and the conversation's end script sets VCG02 to stage 25 on every machine. Opening and picking in a conversation need the proposed bridge methods test.dialogue.talk and test.dialogue.pick, so those steps are blocked until they exist. Data: plugin/dialogue/scenarios/dlg_sunny_accept.json.",
  "players": 2,
  "tags": [
    "dialogue",
    "spectator",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "vcg02": {
      "ref": "FalloutNV.esm:10A214",
      "edid": "VCG02",
      "sig": "QUST"
    },
    "sunny": {
      "ref": "FalloutNV.esm:104E85",
      "edid": "SunnyRef",
      "sig": "ACHR"
    },
    "greeting": {
      "ref": "FalloutNV.esm:10A1EC",
      "sig": "INFO",
      "line": "Well, that"
    },
    "topic": {
      "ref": "FalloutNV.esm:10A1DE",
      "edid": "VCG02GSSunnySmilesTopic000",
      "sig": "DIAL"
    },
    "info": {
      "ref": "FalloutNV.esm:10A1E5",
      "sig": "INFO",
      "line": "Follow me."
    }
  },
  "setup": [
    {
      "id": "objective_10_done",
      "op": "console",
      "cmd": "SetObjectiveCompleted {vcg02} 10 1",
      "on": "host"
    },
    {
      "id": "players_to_sunny",
      "op": "moveto",
      "who": "player",
      "to": "$sunny",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "not_started",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 0
    },
    {
      "id": "guest_talks",
      "op": "talk",
      "npc": "$sunny",
      "greeting": "$greeting",
      "on": "guest"
    },
    {
      "id": "guest_picks",
      "op": "pick",
      "topic": "$topic",
      "info": "$info",
      "on": "guest"
    },
    {
      "id": "stage_25_everywhere",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 25,
      "timeout": 15
    }
  ]
}
