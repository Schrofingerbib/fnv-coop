{
  "schema": 1,
  "name": "ownership_handoff",
  "title": "Ownership handoff: host walks away mid-fight",
  "description": "Both players are at the gang. The host runs to Novac while the gang is alive, so the gang leaves the host's loaded area. Control of the gang must pass to the guest (owner index 1), all machines must agree on the owner, and a kill by the guest afterwards must show up on the host. Owner checks need the proposed bridge method coop.owner and are reported as blocked until it exists.",
  "players": 2,
  "tags": [
    "ownership",
    "combat",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "gang1": {
      "ref": "FalloutNV.esm:104C70",
      "edid": "GSPG01Ref",
      "sig": "ACHR"
    },
    "gang2": {
      "ref": "FalloutNV.esm:104C77",
      "edid": "GSPG02Ref",
      "sig": "ACHR"
    },
    "gang3": {
      "ref": "FalloutNV.esm:104C75",
      "edid": "GSPG03Ref",
      "sig": "ACHR"
    },
    "gangMarker": {
      "ref": "FalloutNV.esm:105D4C",
      "edid": "GoodspringsPowderGangMarker",
      "sig": "REFR"
    },
    "novac": {
      "ref": "FalloutNV.esm:09289B",
      "edid": "NovacMapMarker",
      "sig": "REFR"
    }
  },
  "setup": [
    {
      "id": "enable_gang1",
      "op": "enable",
      "ref": "$gang1"
    },
    {
      "id": "enable_gang2",
      "op": "enable",
      "ref": "$gang2"
    },
    {
      "id": "enable_gang3",
      "op": "enable",
      "ref": "$gang3"
    },
    {
      "id": "players_to_gang",
      "op": "moveto",
      "who": "player",
      "to": "$gang1",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "host_owns_at_start",
      "op": "check",
      "kind": "owner",
      "ref": "$gang1",
      "value": 0
    },
    {
      "id": "host_walks_away",
      "op": "moveto",
      "who": "player",
      "to": "$novac",
      "on": "host"
    },
    {
      "id": "hand_off_window",
      "op": "wait",
      "seconds": 8
    },
    {
      "id": "guest_owns_after",
      "op": "check",
      "kind": "owner",
      "ref": "$gang1",
      "value": 1,
      "timeout": 20
    },
    {
      "id": "alive_still_agreed",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "cmp": "same"
    },
    {
      "id": "guest_kills_1",
      "op": "kill",
      "ref": "$gang1",
      "on": "guest"
    },
    {
      "id": "host_sees_the_kill",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "value": 1,
      "timeout": 10,
      "on": "host"
    }
  ]
}
