{
  "schema": 1,
  "name": "save_load_rejoin",
  "title": "Save / load and rejoin",
  "description": "The host sets a stage and saves. The guest leaves, the host moves the quest on, the guest rejoins and must catch up. The host then loads the save: the quest goes back and the guest must follow. Leave and join steps need the proposed bridge methods coop.leave and coop.join and are reported as blocked until they exist.",
  "players": 2,
  "tags": [
    "save",
    "rejoin",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "vcg02": {
      "ref": "FalloutNV.esm:10A214",
      "edid": "VCG02",
      "sig": "QUST"
    }
  },
  "setup": [
    {
      "id": "settle",
      "op": "wait",
      "seconds": 1
    }
  ],
  "steps": [
    {
      "id": "host_sets_10",
      "op": "setstage",
      "quest": "$vcg02",
      "stage": 10,
      "on": "host"
    },
    {
      "id": "stage_10_everywhere",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 10,
      "timeout": 10
    },
    {
      "id": "host_saves",
      "op": "save",
      "name": "autosaveScenRejoin",
      "on": "host"
    },
    {
      "id": "guest_leaves",
      "op": "leave",
      "on": "guest"
    },
    {
      "id": "host_sets_20",
      "op": "setstage",
      "quest": "$vcg02",
      "stage": 20,
      "on": "host"
    },
    {
      "id": "guest_rejoins",
      "op": "join",
      "on": "guest"
    },
    {
      "id": "guest_caught_up",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 20,
      "timeout": 30
    },
    {
      "id": "host_loads",
      "op": "load",
      "name": "autosaveScenRejoin",
      "on": "host"
    },
    {
      "id": "host_back_at_10",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 10,
      "on": "host",
      "timeout": 30
    },
    {
      "id": "guest_follows",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 10,
      "on": "guest",
      "timeout": 30
    }
  ]
}
