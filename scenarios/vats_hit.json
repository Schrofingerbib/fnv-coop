{
  "schema": 1,
  "name": "vats_hit",
  "title": "VATS hit",
  "description": "The host fires one VATS attack at a Powder Ganger's head after the ganger's health is set to a known value. The damage must show on both machines and agree. The VATS attack needs the proposed bridge method test.vats.hit and is blocked until it exists.",
  "players": 2,
  "tags": [
    "combat",
    "vats",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "gang1": {
      "ref": "FalloutNV.esm:104C70",
      "edid": "GSPG01Ref",
      "sig": "ACHR"
    }
  },
  "setup": [
    {
      "id": "enable_gang1",
      "op": "enable",
      "ref": "$gang1"
    },
    {
      "id": "players_to_gang",
      "op": "moveto",
      "who": "player",
      "to": "$gang1",
      "on": "all"
    },
    {
      "id": "known_health",
      "op": "console",
      "cmd": "{gang1}.setav Health 100",
      "on": "host"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "full_health_everywhere",
      "op": "check",
      "kind": "av",
      "ref": "$gang1",
      "av": "Health",
      "value": 100,
      "tol": 1,
      "timeout": 8
    },
    {
      "id": "host_vats_head",
      "op": "vats_hit",
      "target": "$gang1",
      "limb": "Head",
      "on": "host"
    },
    {
      "id": "hit_resolves",
      "op": "wait",
      "seconds": 4
    },
    {
      "id": "damaged_everywhere",
      "op": "check",
      "kind": "av",
      "ref": "$gang1",
      "av": "Health",
      "cmp": "<",
      "value": 100,
      "timeout": 10
    },
    {
      "id": "machines_agree_on_health",
      "op": "check",
      "kind": "av",
      "ref": "$gang1",
      "av": "Health",
      "cmp": "same",
      "tol": 1
    }
  ]
}
