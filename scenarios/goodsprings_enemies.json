{
  "schema": 1,
  "name": "goodsprings_enemies",
  "title": "Goodsprings enemies: 2 players, powder gangers and geckos",
  "description": "Start state of the four enemy-sync tests (tools/bots/run_fight.py: enemy_fight, enemy_handoff, enemy_spawn, corpse_loot_race). Two powder gangers (GSPG01, GSPG02) and the two VCG02 geckos are enabled at the Goodsprings gang spot and both players stand next to them with their health raised so a real fight cannot end the test. The host puts 3 stimpaks on the first ganger so his corpse has something to loot. The steps are the console version of the fight: the host kills a ganger, the guest kills a gecko, and after each kill every machine must agree on who is dead, on the owner of the survivors and on their health. Owner checks need the bridge method coop.owner. UNVERIFIED in game: the raised-health console line, additem on a living NPC replicating to the guest, and that the VCG02 geckos can be enabled by the console outside their quest.",
  "players": 2,
  "tags": [
    "combat",
    "npc",
    "ownership",
    "spawn",
    "loot",
    "goodsprings",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "gang1": {
      "ref": "FalloutNV.esm:104C70",
      "edid": "GSPG01Ref",
      "sig": "ACHR"
    },
    "gang2": {
      "ref": "FalloutNV.esm:104C77",
      "edid": "GSPG02Ref",
      "sig": "ACHR"
    },
    "gecko1": {
      "ref": "FalloutNV.esm:10A1FE",
      "edid": "VCG02Gecko1REF",
      "sig": "ACRE"
    },
    "gecko2": {
      "ref": "FalloutNV.esm:10A1FD",
      "edid": "VCG02Gecko2REF",
      "sig": "ACRE"
    },
    "gangMarker": {
      "ref": "FalloutNV.esm:105D4C",
      "edid": "GoodspringsPowderGangMarker",
      "sig": "REFR"
    },
    "gangBase": {
      "ref": "FalloutNV.esm:104DF1",
      "edid": "GSPGHM2",
      "sig": "NPC_"
    },
    "novac": {
      "ref": "FalloutNV.esm:09289B",
      "edid": "NovacMapMarker",
      "sig": "REFR"
    },
    "stimpak": {
      "ref": "FalloutNV.esm:015169",
      "edid": "Stimpak",
      "sig": "ALCH"
    },
    "pistol": {
      "ref": "FalloutNV.esm:0E3778",
      "edid": "WeapNV9mmPistol",
      "sig": "WEAP"
    },
    "ammo9mm": {
      "ref": "FalloutNV.esm:08ED03",
      "edid": "Ammo9mm",
      "sig": "AMMO"
    }
  },
  "setup": [
    {
      "id": "enable_gang1",
      "op": "enable",
      "ref": "$gang1"
    },
    {
      "id": "enable_gang2",
      "op": "enable",
      "ref": "$gang2"
    },
    {
      "id": "enable_gecko1",
      "op": "enable",
      "ref": "$gecko1"
    },
    {
      "id": "enable_gecko2",
      "op": "enable",
      "ref": "$gecko2"
    },
    {
      "id": "gecko1_to_gang",
      "op": "moveto",
      "who": "$gecko1",
      "to": "$gangMarker",
      "on": "host",
      "note": "VCG02Gecko1REF stands about 11k units away (Goodsprings Source): bring it into the fight"
    },
    {
      "id": "gecko2_to_gang",
      "op": "moveto",
      "who": "$gecko2",
      "to": "$gangMarker",
      "on": "host",
      "note": "VCG02Gecko2REF, same"
    },
    {
      "id": "players_to_gang",
      "op": "moveto",
      "who": "player",
      "to": "$gang1",
      "on": "all"
    },
    {
      "id": "raise_player_health",
      "op": "console",
      "cmd": "player.setav Health 5000",
      "on": "all",
      "note": "UNVERIFIED console line: the fight must not be able to kill a bot"
    },
    {
      "id": "ammo_9mm",
      "op": "console",
      "cmd": "player.additem {ammo9mm} 300",
      "on": "all",
      "note": "Ammo9mm (FalloutNV.esm:08ED03): the save carries 21 rounds, too few for a whole fight"
    },
    {
      "id": "equip_pistol",
      "op": "console",
      "cmd": "player.equipitem {pistol}",
      "on": "all",
      "note": "WeapNV9mmPistol: the save starts with nothing equipped, so the bots' shots were bare-handed swings at range"
    },
    {
      "id": "stimpaks_on_gang1",
      "op": "additem",
      "who": "$gang1",
      "item": "$stimpak",
      "count": 3,
      "on": "host"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "gang1_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "value": 0
    },
    {
      "id": "gecko1_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gecko1",
      "value": 0
    },
    {
      "id": "owner_of_gang2_agreed",
      "op": "check",
      "kind": "owner",
      "ref": "$gang2",
      "cmp": "same"
    },
    {
      "id": "host_kills_gang1",
      "op": "kill",
      "ref": "$gang1",
      "on": "host"
    },
    {
      "id": "gang1_dead_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$gang1",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "gang2_still_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gang2",
      "value": 0
    },
    {
      "id": "gang2_health_agreed",
      "op": "check",
      "kind": "av",
      "ref": "$gang2",
      "av": "Health",
      "cmp": "same",
      "tol": 1
    },
    {
      "id": "guest_kills_gecko1",
      "op": "kill",
      "ref": "$gecko1",
      "on": "guest"
    },
    {
      "id": "gecko1_dead_everywhere",
      "op": "check",
      "kind": "dead",
      "ref": "$gecko1",
      "value": 1,
      "timeout": 8
    },
    {
      "id": "gecko2_still_alive",
      "op": "check",
      "kind": "dead",
      "ref": "$gecko2",
      "value": 0
    }
  ]
}
