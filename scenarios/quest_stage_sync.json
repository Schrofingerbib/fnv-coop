{
  "schema": 1,
  "name": "quest_stage_sync",
  "title": "Quest stage sync (Back in the Saddle)",
  "description": "Stages of VCG02 are set from both machines. Each set must show up on every machine, earlier stages must stay done, and a quest variable written on the host must not break the stage.",
  "players": 2,
  "tags": [
    "quest",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "vcg02": {
      "ref": "FalloutNV.esm:10A214",
      "edid": "VCG02",
      "sig": "QUST"
    }
  },
  "setup": [
    {
      "id": "settle",
      "op": "wait",
      "seconds": 1
    }
  ],
  "steps": [
    {
      "id": "starts_at_zero",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 0
    },
    {
      "id": "host_sets_10",
      "op": "setstage",
      "quest": "$vcg02",
      "stage": 10,
      "on": "host"
    },
    {
      "id": "stage_10_everywhere",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 10,
      "timeout": 10
    },
    {
      "id": "guest_sets_20",
      "op": "setstage",
      "quest": "$vcg02",
      "stage": 20,
      "on": "guest"
    },
    {
      "id": "stage_20_everywhere",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 20,
      "timeout": 10
    },
    {
      "id": "stage_10_stays_done",
      "op": "check",
      "kind": "stage_done",
      "quest": "$vcg02",
      "stage": 10,
      "value": 1
    },
    {
      "id": "host_sets_var",
      "op": "setvar",
      "quest": "$vcg02",
      "var": "nGeckosKilled",
      "value": 2,
      "on": "host"
    },
    {
      "id": "host_sets_100",
      "op": "setstage",
      "quest": "$vcg02",
      "stage": 100,
      "on": "host"
    },
    {
      "id": "stage_100_everywhere",
      "op": "check",
      "kind": "stage",
      "quest": "$vcg02",
      "value": 100,
      "timeout": 10
    },
    {
      "id": "stage_20_stays_done",
      "op": "check",
      "kind": "stage_done",
      "quest": "$vcg02",
      "stage": 20,
      "value": 1
    }
  ]
}
