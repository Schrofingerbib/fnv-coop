{
  "schema": 1,
  "name": "loot_race",
  "title": "Loot race: both players grab the same item",
  "description": "Both players stand at the same world item (the teddy bear from quest VMS13) and activate it at the same moment. Exactly one copy must exist in total: the item must not be duplicated and must not vanish.",
  "players": 2,
  "tags": [
    "loot",
    "race",
    "2p"
  ],
  "start": {
    "save": "autosave"
  },
  "reset": {
    "group": "goodsprings"
  },
  "forms": {
    "teddyRef": {
      "ref": "FalloutNV.esm:0F8B6C",
      "edid": "VMS13TeddyBearRef",
      "sig": "REFR"
    },
    "teddy": {
      "ref": "FalloutNV.esm:0F8891",
      "edid": "VMS13TeddyBear",
      "sig": "MISC"
    }
  },
  "setup": [
    {
      "id": "enable_teddy",
      "op": "enable",
      "ref": "$teddyRef"
    },
    {
      "id": "players_to_item",
      "op": "moveto",
      "who": "player",
      "to": "$teddyRef",
      "on": "all"
    },
    {
      "id": "settle",
      "op": "wait",
      "seconds": 3
    }
  ],
  "steps": [
    {
      "id": "nobody_has_it",
      "op": "check",
      "kind": "item_count",
      "who": "player",
      "item": "$teddy",
      "value": 0,
      "agg": "sum"
    },
    {
      "id": "both_grab",
      "op": "activate",
      "ref": "$teddyRef",
      "on": "all",
      "parallel": true
    },
    {
      "id": "exactly_one_copy",
      "op": "check",
      "kind": "item_count",
      "who": "player",
      "item": "$teddy",
      "value": 1,
      "agg": "sum",
      "timeout": 10
    },
    {
      "id": "no_player_has_two",
      "op": "check",
      "kind": "item_count",
      "who": "player",
      "item": "$teddy",
      "value": 1,
      "cmp": "<=",
      "agg": "max"
    }
  ]
}
